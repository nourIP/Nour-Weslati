import java.util.Scanner;

public class ZooManagement {

    int nbrCages = 20;
    String zooName = "my zoo";

    public static void main(String[] args) {

        ZooManagement zoo = new ZooManagement();


        System.out.println("Bienvenue dans " + zoo.zooName + " qui contient " + zoo.nbrCages + " cages.");

       
        Scanner sc = new Scanner(System.in);


        System.out.print("Entrez le nom de votre zoo : ");
        String inputName = sc.nextLine();
        if (!inputName.trim().isEmpty()) {
            zoo.zooName = inputName;
        }


        System.out.print("Entrez le nombre de cages : ");
        int inputCages = sc.nextInt();
        if (inputCages > 0) {
            zoo.nbrCages = inputCages;

        }
        else {
            System.out.println("Veuillez saisir un nombre de cage positif");
        }


        System.out.println("Votre zoo s'appelle " + zoo.zooName + " et contient " + zoo.nbrCages + " cages.");

        sc.close();
    }
}
